# Integração de e-mail — manter em secrets do Vercel, jamais no GitHub
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile — chave pública e secreta da mesma configuração
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Domínio público autorizado para POST, sem barra final
CONTACT_ALLOWED_ORIGIN=https://instituto-chroma-oficial.vercel.app

# Ativar somente após aprovação institucional e jurídica da privacidade.
# Valor obrigatório: true (exatamente)
CONTACT_PRIVACY_APPROVED=false
